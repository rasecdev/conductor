# Scripts run under bash/python on Linux CI and in Git Bash; CRLF breaks them.
*.sh text eol=lf
*.py text eol=lf
# Expected outputs of scripts/test_state.sh are compared byte for byte.
evals/state-expected/*.json text eol=lf
# Same for scripts/test_check_gates.sh (v1.6).
evals/check-gates-expected/*.txt text eol=lf
# Generated by scripts/generate_benchmark_charts.py; byte-compared by
# scripts/test_generate_benchmark_charts.sh (v1.8).
docs/benchmarks/*.svg text eol=lf
